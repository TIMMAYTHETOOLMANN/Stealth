# Stealth Job Application Agent — environment configuration
# Copy to .env.local and adjust as needed.

# HTTP endpoint of the always-on mcp-stealth-chrome bridge (supergateway).
# Started via the command documented in README.md.
STEALTH_MCP_URL=http://127.0.0.1:8000/mcp

# Secret used to sign session tokens. Generate a long random value in production.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
AUTH_SECRET=change-me-to-a-long-random-string

# Directory for the JSON data store (defaults to ./data).
# DATA_DIR=./data
